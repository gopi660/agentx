GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
MAX_TOOL_ITERATIONS=5
MAX_DUPLICATE_RETRIES=2

# Stateful Conversation Memory Configuration
# Options: sqlite (default, persistent in data/conversations.db) or memory (ephemeral)
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=data/conversations.db
MAX_HISTORY_MESSAGES=20

# Web Search Configuration
# Options: duckduckgo (default, no key required), tavily, serpapi
SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=your_tavily_key_here
# SERPAPI_API_KEY=your_serpapi_key_here
SEARCH_MAX_RESULTS=5
MAX_SEARCH_ATTEMPTS_PER_REQUEST=3
CURRENT_YEAR=2026
